{% schema %}
{
  "name": "Collection Tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Catalog"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "carousel",
      "label": "Enable carousel",
      "default": false
    },
    {
    "type": "select",
    "id": "image_ratio",
    "label": "Image ratio",
    "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
    ],
    "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_hover",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_name",
          "label": "Tab Name",
          "default": "All"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Tabs"
    }
  ]
}
{% endschema %}
<div id="tabs-{{ section.id }}" class="page-width {% if section.settings.full_width %}full-width{% endif %}">
  
  <!-- HEADER -->
  <div class="section-header" style="display:flex; justify-content:space-between; align-items:center;">
    
   

    <!-- TABS -->
    <div class="tabs">
      {% for block in section.blocks %}
        <button class="tab-btn {% if forloop.first %}active{% endif %}" data-tab="tab-{{ section.id }}-{{ forloop.index }}">
          {{ block.settings.tab_name }}
        </button>
      {% endfor %}
    </div>

  </div>

  <!-- TAB CONTENT -->
  {% for block in section.blocks %}
    <div class="tab-content {% if forloop.first %}active{% endif %}" id="tab-{{ section.id }}-{{ forloop.index }}">
      <div class="grid" style="display:grid; grid-template-columns: repeat({{ section.settings.columns }},1fr); gap:20px;">
        
        {% for product in block.settings.collection.products limit:4 %}
          
          <div class="card">
             <a href="{{ product.url }}" class="card-link">
            <div class="card-media ratio--{{ section.settings.image_ratio }}">

              <img 
                src="{{ product.featured_image | image_url: width: 600 }}"
                class="main-img"
              >

              {% if section.settings.show_hover and product.images.size > 1 %}
                <img 
                  src="{{ product.images[1] | image_url: width: 600 }}"
                  class="hover-img"
                >
              {% endif %}

            </div>

            <div class="card-info">

              {% if section.settings.show_vendor %}
                <p class="vendor">{{ product.vendor }}</p>
              {% endif %}

              <h4>{{ product.title }}</h4>

              <p>{{ product.price | money }}</p>


            </div>
            </a>
          </div>

        {% endfor %}

      </div>
    </div>
  {% endfor %}

</div>

<style>
.tabs button {
  margin: 5px;
  padding: 8px 12px;
  cursor: pointer;
}

.tab-content {
  display: none;
}
.card-link {
  text-decoration: none;
  color: inherit;
  display: block;
}
.tab-content.active {
  display: block;
}

.card {
  position: relative;
}

.card-media {
  position: relative;
  overflow: hidden;
}
/* BASE */
.card-media {
  position: relative;
  overflow: hidden;
}

/* RATIO SYSTEM */
.ratio--square {
  aspect-ratio: 1 / 1;
}

.ratio--portrait {
  aspect-ratio: 3 / 4;
}

.ratio--adapt {
  aspect-ratio: auto;
}

/* IMAGE FIT */
.card-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ADAPT FIX */
.ratio--adapt img {
  height: auto;
  object-fit: contain;
}
.card-media img {
  width: 100%;
  transition: 0.3s;
}

.hover-img {
  position: absolute;
  top:0;
  left:0;
  opacity:0;
}

.card-media:hover .hover-img {
  opacity:1;
}

.card-media:hover .main-img {
  opacity:0;
}
/* MOBILE RESPONSIVE */
@media (max-width: 768px) {

  /* HEADER STACK */
  .section-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  /* TABS SCROLLABLE */
  .tabs {
    display: flex;
    overflow-x: auto;
    width: 100%;
    gap: 8px;
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  .tabs button {
    flex: 0 0 auto;
    white-space: nowrap;
    font-size: 14px;
    padding: 6px 10px;
  }

  /* GRID 2 COLUMNS */
  

  /* CARD TEXT SMALL */
  .card-info h4 {
    font-size: 14px;
  }

  .card-info p {
    font-size: 13px;
  }



  /* IMAGE HEIGHT FIX */
  .card-media {
    width: 100%;
  }

}
.tabs button
 {
    background: black;
    color: white;
    padding: 14px 22px;
    font-size: 17px;
}
.card-info p {
    padding: 0;
    margin: 0;
}

.card-info h4 {
    margin-bottom: 0;
}
@media(min-width:768px){
.section-header h2 {
    font-size: calc(var(--font-heading-scale) * 4rem);
}
}
/* EXTRA SMALL (phones) */
@media (max-width: 480px) {


  .tabs button {
    font-size: 14px;
        padding: 12px 8px;
  }

}
@media (max-width: 768px) {
    .tabs {
        display: flex;
        overflow-x: auto;
        width: 100%;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: center;
        padding: 20px 0;
    }
}
</style>

<script>
document.querySelectorAll("[id^='tabs-']").forEach(section => {

  const tabs = section.querySelectorAll(".tab-btn");
  const contents = section.querySelectorAll(".tab-content");

  tabs.forEach(tab => {
    tab.addEventListener("click", () => {

      const target = tab.getAttribute("data-tab");

      contents.forEach(c => c.classList.remove("active"));
      tabs.forEach(t => t.classList.remove("active"));

      section.querySelector("#" + target).classList.add("active");
      tab.classList.add("active");
    });
  });

});
</script>
